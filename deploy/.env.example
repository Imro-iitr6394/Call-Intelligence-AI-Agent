# Copy this file to .env in the project root and fill in real values.
# Never commit .env -- it is already gitignored.

# Transcription (AssemblyAI) -- required for audio uploads, not for typed transcripts
TRANSCRIPTION_PROVIDER=assemblyai
TRANSCRIPTION_API_KEY=

# Extraction (Gemini) -- up to 3 keys, rotated automatically on quota errors (HTTP 429)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional monitoring -- safe to leave unset/false
OBSERVABILITY_ENABLED=false
LOGFIRE_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
